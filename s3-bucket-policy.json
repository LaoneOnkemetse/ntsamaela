{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "AllowS3BucketAccess",
      "Effect": "Allow",
      "Action": [
        "s3:PutObject",
        "s3:GetObject",
        "s3:DeleteObject",
        "s3:ListBucket",
        "s3:GetObjectVersion"
      ],
      "Resource": [
        "arn:aws:s3:::ntsamaela-documents",
        "arn:aws:s3:::ntsamaela-documents/*",
        "arn:aws:s3:::ntsamaela-packages",
        "arn:aws:s3:::ntsamaela-packages/*",
        "arn:aws:s3:::ntsamaela-uploads",
        "arn:aws:s3:::ntsamaela-uploads/*"
      ]
    }
  ]
}

