# Prefer exact installs in CI; reduce registry flakiness
save-exact=false
engine-strict=true

# Retries and timeouts for flaky registry (e.g. Railway build)
fetch-retries=5
fetch-retry-mintimeout=20000
fetch-retry-maxtimeout=120000
fetch-timeout=300000

# Prefer offline when possible (use with npm ci)
prefer-offline=false
