# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ntsamaela_dev

# Redis
REDIS_URL=redis://localhost:6379

# JWT Secrets
JWT_SECRET=your-jwt-secret-here
JWT_REFRESH_SECRET=your-jwt-refresh-secret-here
ADMIN_JWT_SECRET=your-admin-jwt-secret-here

# Admin bootstrap (required for web-admin login on first deploy)
ADMIN_EMAIL=admin@yourdomain.com
ADMIN_PASSWORD=change-me-min-8-chars
# ADMIN_FIRST_NAME=Admin
# ADMIN_LAST_NAME=User
# ADMIN_PHONE=+26770000000
# Set true only when intentionally resetting admin password on deploy
# ADMIN_SYNC_PASSWORD=false

# AWS Credentials (for verification service)
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_REGION=us-east-1
AWS_S3_BUCKET=ntsamaela-uploads

# Google Cloud (for verification service)
GOOGLE_APPLICATION_CREDENTIALS=path/to/credentials.json

# Server
PORT=3000
NODE_ENV=development

# Frontend URL
FRONTEND_URL=http://localhost:5000

# Firebase (for notifications)
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_PRIVATE_KEY=your-private-key
FIREBASE_CLIENT_EMAIL=your-client-email

# Payment Providers
PAYMENT_PROVIDER=dpo
# mock | dpo | paystack | stripe

# DPO Pay (3G Direct Pay) — use sandbox credentials until live merchant account is approved
# Docs: https://docs.dpopay.com/dpo-pay-by-network/reference/sandbox-test-credentials
DPO_COMPANY_TOKEN=8D3DA73D-9D7F-4E09-96D4-3D44E7A83EA3
DPO_SERVICE_TYPE=3854
DPO_API_URL=https://secure.3gdirectpay.com/API/v6/
DPO_CHECKOUT_URL=https://secure.3gdirectpay.com/payv3.php
DPO_PAYMENT_CURRENCY=ZAR
DPO_PTL_HOURS=5
DPO_CALLBACK_URL=https://your-api-domain.up.railway.app/api/webhooks/dpo
DPO_REDIRECT_URL=https://your-api-domain.up.railway.app/api/wallet/recharge/return
API_PUBLIC_URL=https://your-api-domain.up.railway.app

# Legacy / optional
STRIPE_SECRET_KEY=your-stripe-secret
PAYSTACK_SECRET_KEY=your-paystack-secret

# Email
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your-email
SMTP_PASS=your-password
